# Lab runner config — copy this to .lab-runner.env and fill in your values.
# .lab-runner.env is gitignored and never committed.

# IP address of your Kali VM (check with: ip addr in Kali)
KALI_HOST=192.168.50.10

# SSH username for Kali (default Kali install uses 'kali')
KALI_USER=kali

# Path to your SSH private key — leave blank to use SSH agent
KALI_SSH_KEY=~/.ssh/id_rsa
